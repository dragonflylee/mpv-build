#!/usr/bin/make -f

PREFIX ?= /usr/local
TMPDIR ?= /tmp

include /usr/share/dpkg/architecture.mk

export PKG_CONFIG_PATH=$(PREFIX)/lib/pkgconfig
export LD_LIBRARY_PATH=/usr/lib/$(DEB_BUILD_GNU_TYPE)/pulseaudio

ifeq ($(DEB_BUILD_ARCH),amd64)
	FFMPEG_FLAGS=--enable-asm --enable-nvdec --enable-ffnvcodec
else
	FFMPEG_FLAGS=--enable-neon --enable-v4l2_m2m --enable-libudev --enable-v4l2-request
endif

dav1d:
	wget -qO- https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz | tar Jxf - -C $(TMPDIR)
	meson setup build-dav1d $(TMPDIR)/dav1d-1.5.4 --prefix=$(PREFIX) \
		--buildtype=release --default-library=static -Denable_tools=false \
		-Denable_examples=false -Denable_tests=false -Denable_docs=false
	meson compile -C build-dav1d
	meson install -C build-dav1d

nv-codec-headers:
	wget -qO- https://github.com/FFmpeg/nv-codec-headers/archive/n13.1.15.0.tar.gz | tar zxf - -C $(TMPDIR)
	make -C $(TMPDIR)/nv-codec-headers-n13.1.15.0 PREFIX=$(PREFIX) install

harfbuzz:
	wget -qO- https://github.com/harfbuzz/harfbuzz/releases/download/14.4.0/harfbuzz-14.4.0.tar.xz | tar Jxf - -C $(TMPDIR)
	meson setup build-harfbuzz $(TMPDIR)/harfbuzz-14.4.0 --prefix=$(PREFIX) --libdir=lib \
		--buildtype=release --default-library=static -Dtests=disabled -Ddocs=disabled -Dicu=disabled \
		-Dcairo=disabled -Dgobject=disabled -Dbenchmark=disabled -Dutilities=disabled
	meson compile -C build-harfbuzz
	meson install -C build-harfbuzz

fribidi:
	wget -qO- https://github.com/fribidi/fribidi/releases/download/v1.0.16/fribidi-1.0.16.tar.xz | tar Jxf - -C $(TMPDIR)
	meson setup build-fribidi $(TMPDIR)/fribidi-1.0.16 --prefix=$(PREFIX) --libdir=lib \
		--buildtype=release --default-library=static -Dbin=false -Ddocs=false -Dtests=false
	meson compile -C build-fribidi
	meson install -C build-fribidi

libass: harfbuzz fribidi
	wget -qO- https://github.com/libass/libass/releases/download/0.17.5/libass-0.17.5.tar.xz | tar Jxf - -C $(TMPDIR)
	meson setup build-libass $(TMPDIR)/libass-0.17.5 --prefix=$(PREFIX) --libdir=lib \
		--buildtype=release --default-library=static
	meson compile -C build-libass
	meson install -C build-libass

ffmpeg: dav1d nv-codec-headers
	wget -qO- https://ffmpeg.org/releases/ffmpeg-9.0.1.tar.xz | tar Jxf - -C $(TMPDIR)
	patch -d $(TMPDIR)/ffmpeg-9.0.1 -Nbp1 -i $(CURDIR)/patches/ffmpeg-v4l2request.patch
	mkdir -p build-ffmpeg && cd build-ffmpeg && \
	$(TMPDIR)/ffmpeg-9.0.1/configure --prefix=$(PREFIX) --disable-shared --enable-static \
		--enable-pthreads --enable-runtime-cpudetect --pkg-config-flags=--static $(FFMPEG_FLAGS) \
		--disable-programs --disable-debug --disable-doc --disable-autodetect --enable-pic  \
		--disable-muxers --enable-libdrm --enable-vaapi --enable-vdpau --disable-encoders --enable-encoder=png \
		--disable-avdevice --disable-filters --enable-filter=hflip,vflip,transpose \
		--enable-zlib --enable-libdav1d --enable-openssl --enable-nonfree
	make -C build-ffmpeg -j$(shell nproc)
	make -C build-ffmpeg install

libplacebo:
	git clone https://github.com/haasn/libplacebo.git -b v7.360.1 --depth 1 --recurse-submodules $(TMPDIR)/libplacebo
	meson setup build-libplacebo $(TMPDIR)/libplacebo --prefix=$(PREFIX) --libdir=lib --buildtype=release \
		--default-library=static -Ddovi=enabled -Ddemos=false -Dtests=false -Dlcms=disabled -Dvulkan=disabled
	meson compile -C build-libplacebo
	meson install -C build-libplacebo

hwdata:
	wget -qO- https://github.com/vcrhonek/hwdata/archive/v0.410.tar.gz | tar zxf - -C $(TMPDIR)
	cd $(TMPDIR)/hwdata-0.410 && ./configure --disable-blacklist
	make -C $(TMPDIR)/hwdata-0.410 install

libdisplay-info: hwdata
	wget -qO- https://gitlab.freedesktop.org/emersion/libdisplay-info/-/releases/0.4.0/downloads/libdisplay-info-0.4.0.tar.xz | tar Jxf - -C $(TMPDIR)
	meson setup build-libdisplay-info $(TMPDIR)/libdisplay-info-0.4.0 --prefix=$(PREFIX) --libdir=lib --default-library=static
	meson compile -C build-libdisplay-info
	meson install -C build-libdisplay-info

depends: libass ffmpeg libplacebo libdisplay-info
	wget -qO- https://github.com/mpv-player/mpv/archive/v0.41.0.tar.gz | tar zxf - --strip-components=1
	wget -qO- https://github.com/mpv-player/mpv/commit/4b6ebd79c84fee93ee47090ecbee2eee9fadb961.patch | patch -d $(CURDIR) -Nbp1 -i -
	patch -Nbp1 -i $(CURDIR)/patches/mpv-v4l2request.patch

%:
	dh $@ --buildsystem=meson --builddirectory=build-mpv

override_dh_auto_configure:
	dh_auto_configure -- \
		-Dc_link_args='-lstdc++' \
		-Dlibmpv=true \
		-Dbuild-date=false \
		-Dcplayer=true \
		-Dtests=false \
		-Dvulkan=disabled

override_dh_auto_test:

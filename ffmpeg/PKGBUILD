# Contributor: jakibaki <jakibaki live com>

pkgname=switch-ffmpeg
pkgver=8.1.1
pkgrel=5
pkgdesc='ffmpeg port (for Nintendo Switch homebrew development)'
arch=('any')
url='https://ffmpeg.org/'
license=('GPL')
options=(!strip staticlibs)
makedepends=('switch-pkg-config' 'dkp-toolchain-vars')
depends=('switch-zlib' 'switch-bzip2' 'switch-dav1d' 'envideo')
source=(
  "https://ffmpeg.org/releases/ffmpeg-${pkgver}.tar.xz"
  "envideo.patch" "tls.patch"
)
sha256sums=('b6863adde98898f42602017462871b5f6333e65aec803fdd7a6308639c52edf3' 'SKIP' 'SKIP')

groups=('switch-portlibs')

prepare() {
  cd ffmpeg-$pkgver
  patch -Np1 -i "$srcdir/envideo.patch"
  patch -Np1 -i "$srcdir/tls.patch"
}

build() {
  cd ffmpeg-$pkgver

  source ${DEVKITPRO}/switchvars.sh

  ./configure --prefix=$PORTLIBS_PREFIX --enable-gpl --disable-shared --enable-static \
    --cross-prefix=aarch64-none-elf- --enable-cross-compile \
    --arch=aarch64 --cpu=cortex-a57 --target-os=horizon --enable-pic \
    --extra-cflags='-D__SWITCH__ -D_GNU_SOURCE -O2 -march=armv8-a -mtune=cortex-a57 -mtp=soft -fPIC -ftls-model=local-exec' \
    --extra-cxxflags='-D__SWITCH__ -D_GNU_SOURCE -O2 -march=armv8-a -mtune=cortex-a57 -mtp=soft -fPIC -ftls-model=local-exec' \
    --extra-ldflags='-specs=${DEVKITPRO}/libnx/switch.specs -fPIE' \
    --disable-runtime-cpudetect --disable-programs --disable-debug --disable-doc --disable-autodetect \
    --enable-asm --enable-neon --disable-avdevice --disable-encoders --disable-muxers \
    --enable-swscale --enable-swresample --enable-network  \
    --disable-decoders --enable-decoder=flac,aac,opus,mp3,h264,hevc,libdav1d \
    --disable-demuxers --enable-demuxer=mov,flv,hls \
    --disable-protocols --enable-protocol=file,http,tcp,udp,hls,https,tls,rtp,crypto,httpproxy \
    --enable-zlib --enable-bzlib --enable-libdav1d --enable-libnx --enable-envideo \
    --disable-filters --enable-filter=hflip,vflip,transpose,deinterlace_envideo,denoise_envideo,sharpness_envideo

  make -j$(nproc)
}

package() {
  cd ffmpeg-$pkgver

  source ${DEVKITPRO}/switchvars.sh

  make DESTDIR="$pkgdir" install

  # remove examples
  rm -r "$pkgdir"${PORTLIBS_PREFIX}/share
}

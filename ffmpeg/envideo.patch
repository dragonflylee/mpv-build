diff --git a/libavcodec/envideo_decode.c b/libavcodec/envideo_decode.c
new file mode 100644
index 0000000000..4f9f5e2d60
--- /dev/null
+++ b/libavcodec/envideo_decode.c
@@ -0,0 +1,531 @@
+/*

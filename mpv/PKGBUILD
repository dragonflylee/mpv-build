# Maintainer: Alexey Pavlov <alexpux@gmail.com>
# Contributor: James Ross-Gowan <rossymiles@gmail.com>

_realname=mpv
pkgbase="mingw-w64-${_realname}"
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=master
pkgrel=2
pkgdesc="Video player based on MPlayer/mplayer2 (mingw-w64)"
url="https://mpv.io/"
arch=('any')
mingw_arch=('mingw32' 'mingw64' 'clangarm64')
license=('spx:GPL-2.0-only' 'spx:LGPL-2.1-only')
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-meson"
  "${MINGW_PACKAGE_PREFIX}-ninja"
  "${MINGW_PACKAGE_PREFIX}-pkgconf"
  "${MINGW_PACKAGE_PREFIX}-ffmpeg"
  "${MINGW_PACKAGE_PREFIX}-libass"
  "${MINGW_PACKAGE_PREFIX}-shaderc"
  "${MINGW_PACKAGE_PREFIX}-spirv-cross"
  "${MINGW_PACKAGE_PREFIX}-libplacebo"
)
options=('strip')
source=(
  "git+https://github.com/mpv-player/${_realname}.git"
  "win7-compat.patch"
)
sha256sums=('SKIP' 'SKIP')

pkgver() {
  cd "${srcdir}/${_realname}"
  git rev-parse --short=7 HEAD
}

prepare() {
  cd "${srcdir}/${_realname}"
  patch -Nbp1 -i "${srcdir}/win7-compat.patch"
}

build() {
  sed -i "s/UNKNOWN/$pkgver/" "${srcdir}/${_realname}/MPV_VERSION"

  if [[ ${MSYSTEM} == CLANG* ]]; then
    LDFLAGS="-lc++ -static"
  else
    LDFLAGS="-lstdc++ -static-libstdc++ -static"
  fi

  MSYS2_ARG_CONV_EXCL="--prefix=" \
    meson setup \
      --prefix="${MINGW_PREFIX}" \
      --buildtype=release \
      --default-library=shared \
      --prefer-static \
      -Dlibmpv=true \
      -Dcplayer=false \
      -Dtests=false \
      -Dgl-win32=disabled \
      -Degl-angle-lib=disabled \
      -Dd3d11=enabled \
      -Dvulkan=disabled \
      -Dlibarchive=disabled \
      "build-${MSYSTEM}" \
      "${srcdir}/${_realname}"
  meson compile -C "build-${MSYSTEM}"
}

package() {
  meson install -C "build-${MSYSTEM}" --destdir "${pkgdir}"
  sed -s "/private/d" -i ${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/mpv.pc
  sed -s "s|$(cygpath -am ${MINGW_PREFIX})|${MINGW_PREFIX}|g" -i ${pkgdir}${MINGW_PREFIX}/lib/pkgconfig/mpv.pc
}
